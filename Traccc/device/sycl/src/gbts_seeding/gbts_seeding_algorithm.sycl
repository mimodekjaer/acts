        [payload](::sycl::nd_item<1> item) {
          device::gbts_find_minmax_radius(details::thread_id<1>{item}, payload);
        });
  });
}

void gbts_seeding_algorithm::gbts_make_graph_edges_kernel(
    const device::gbts_make_graph_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 128;
  const unsigned int n_blocks = payload.nUsedBinPairs;
  squeue.submit([&](::sycl::handler& h) {
    // Shared-memory scratch: a block-local copy of the current node1 chunk.
    vecmem::sycl::local_accessor<float> phi(
        traccc::device::gbts_consts::node_buffer_length, h);
    vecmem::sycl::local_accessor<traccc::float4> node_pack(
        traccc::device::gbts_consts::node_buffer_length, h);

    h.parallel_for<kernels::gbts_make_graph_edges>(
        details::calculate1DimNdRange(n_blocks * n_threads, n_threads),
        [payload, phi, node_pack](::sycl::nd_item<1> item) {
          const details::barrier<1> barrier{item};
          device::gbts_make_graph_edges(
              details::thread_id<1>{item}, barrier, payload,
              {vecmem::data::vector_view<float>(
                   traccc::device::gbts_consts::node_buffer_length, &phi[0]),
               vecmem::data::vector_view<traccc::float4>(
                   traccc::device::gbts_consts::node_buffer_length,
                   &node_pack[0])});
        });
  });

  vecmem::device_vector<unsigned int> d_num_outgoing_edges(
      payload.num_outgoing_edges);
  oneapi::dpl::inclusive_scan(oneapi::dpl::execution::device_policy{squeue},
                              d_num_outgoing_edges.begin(),
                              d_num_outgoing_edges.end(),
                              d_num_outgoing_edges.begin());
}

void gbts_seeding_algorithm::gbts_link_graph_edges_kernel(
    const device::gbts_link_graph_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 256;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_link_graph_edges>(
        details::calculate1DimNdRange(payload.nEdges, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_link_graph_edges(details::thread_id<1>{item}, payload);
        });
  });
}

void gbts_seeding_algorithm::gbts_sort_graph_edges_kernel(
    const device::gbts_sort_graph_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 128;
  // Small buckets: one thread per edge.
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_sort_graph_edges_small>(
        details::calculate1DimNdRange(payload.nEdges, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_sort_graph_edges_small(details::thread_id<1>{item},
                                              payload);
        });
  });
  // Large buckets: blocks stride over the nodes a block's worth at a time.
  const unsigned int n_blocks_large =
      std::min(1 + (payload.nNodes - 1) / device::gbts_sort_graph_edges_block_size,
               4096u);
  squeue.submit([&](::sycl::handler& h) {
    vecmem::sycl::local_accessor<unsigned int> bucket_cache(
        device::gbts_sort_graph_edges_cache_size, h);
    vecmem::sycl::local_accessor<unsigned int> large_flags(
        device::gbts_sort_graph_edges_block_size, h);

    h.parallel_for<kernels::gbts_sort_graph_edges_large>(
        details::calculate1DimNdRange(
            n_blocks_large * device::gbts_sort_graph_edges_block_size,
            device::gbts_sort_graph_edges_block_size),
        [payload, bucket_cache, large_flags](::sycl::nd_item<1> item) {
          const details::barrier<1> barrier{item};
          device::gbts_sort_graph_edges_large(
              details::thread_id<1>{item}, barrier, payload,
              {vecmem::data::vector_view<unsigned int>(
                   device::gbts_sort_graph_edges_cache_size,
                   &bucket_cache[0]),
               vecmem::data::vector_view<unsigned int>(
                   device::gbts_sort_graph_edges_block_size,
                   &large_flags[0])});
        });
  });
}

void gbts_seeding_algorithm::gbts_match_graph_edges_kernel(
    const device::gbts_match_graph_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 256;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_match_graph_edges>(
        details::calculate1DimNdRange(payload.nEdges, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_match_graph_edges(details::thread_id<1>{item}, payload);
        });
