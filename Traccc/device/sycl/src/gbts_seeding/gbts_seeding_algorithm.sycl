void gbts_seeding_algorithm::gbts_count_terminus_edges_kernel(
    const device::gbts_count_terminus_edges_payload& payload) const {
  ::sycl::queue& squeue = details::get_queue(queue());
  squeue.throw_asynchronous();

  const unsigned int n_threads = 128;
  squeue.submit([&](::sycl::handler& h) {
    h.parallel_for<kernels::gbts_count_terminus_edges>(
        details::calculate1DimNdRange(payload.nConnectedEdges, n_threads),
        [payload](::sycl::nd_item<1> item) {
          device::gbts_count_terminus_edges(details::thread_id<1>{item},
                                            payload);
        });
  });

  // Lay out the path store: each terminus edge gets a contiguous row range.
  oneapi::dpl::inclusive_scan(oneapi::dpl::execution::device_policy{squeue},
                              payload.row_sizes.ptr(),
                              payload.row_sizes.ptr() + payload.nConnectedEdges,
                              payload.row_sizes.ptr());
}

